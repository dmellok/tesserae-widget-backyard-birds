{
  "tesserae_compat": "1.x",
  "name": "Backyard Birds",
  "version": "0.16.0",
  "kind": "widget",
  "render": {
    "warm_ahead_s": 150
  },
  "description": "The birds BirdNET-Go has heard today, with classic plates by Audubon, Gould and Lear or AI paintings in 47 styles or your own prompt. Eight layouts, from a field log and a dawn chorus to a page of the day's birds. Colour, greyscale and mono panels. Demo garden until set up.",
  "icon": "ph-bird",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:*"
  ],
  "settings": [
    {
      "name": "fal_api_key",
      "type": "string",
      "label": "fal.ai API key (AI paintings, experimental)",
      "secret": true,
      "default": "",
      "help": "Only needed for the AI painting picture options. Each bird is painted once, from an openly licensed reference photo, in the background (it shows on a later refresh), and kept, at about US$0.04 a bird up to the daily limit below. Manage the paintings on this widget's page under Widgets. Get a key at https://fal.ai/dashboard/keys; it is only sent to fal.run."
    },
    {
      "name": "gen_daily_cap",
      "type": "select",
      "label": "AI paintings per day",
      "default": "12",
      "help": "The most new AI paintings (and cluster blends) made in a day, at about US$0.04 each. Paintings are kept, so a garden's birds only cost once; raise this to fill a new garden or a specimen sheet faster.",
      "choices": [
        {
          "value": "6",
          "label": "6 (about US$0.24)"
        },
        {
          "value": "12",
          "label": "12 (about US$0.48)"
        },
        {
          "value": "24",
          "label": "24 (about US$0.96)"
        },
        {
          "value": "48",
          "label": "48 (about US$1.92)"
        },
        {
          "value": "96",
          "label": "96 (about US$3.84)"
        }
      ]
    }
  ],
  "cell_options": [
    {
      "name": "url",
      "type": "string",
      "label": "BirdNET-Go address",
      "default": "",
      "help": "Where BirdNET-Go's web page opens, for example http://birdnet.local:8080. Leave empty for a demo garden based on this cell's location."
    },
    {
      "name": "layout",
      "type": "select",
      "label": "Layout",
      "default": "list",
      "choices": [
        {
          "value": "list",
          "label": "Field log: the bird just heard, the rest named beside it"
        },
        {
          "value": "latest",
          "label": "Latest visitor: the bird just heard, large, with today's tally"
        },
        {
          "value": "gallery",
          "label": "Gallery: a specimen card for each bird"
        },
        {
          "value": "chart",
          "label": "Day chart: a ledger of who called in which hour"
        },
        {
          "value": "plate",
          "label": "Book plate: a page from a field guide"
        },
        {
          "value": "bleed",
          "label": "Full bleed: the latest bird's picture fills the cell"
        },
        {
          "value": "cluster",
          "label": "Cluster: today's busiest birds together in one picture"
        },
        {
          "value": "chorus",
          "label": "Dawn chorus: today's birds along a timeline, at the time each was first heard"
        },
        {
          "value": "atlas",
          "label": "Atlas: every bird ever heard here, as stamps on a sheet"
        }
      ]
    },
    {
      "name": "window",
      "type": "select",
      "label": "Window",
      "default": "today",
      "help": "Today is BirdNET-Go's day as it fills. The windows shorter than a day are counted off BirdNET-Go's latest detections, as Fugleramme counts them, so their hours show; the longer ones come from its species summary, which has no hours, so the hour strips go quiet. The day chart and the dawn chorus always show today.",
      "show_if": {
        "layout": [
          "list",
          "latest",
          "gallery",
          "cluster",
          "plate",
          "bleed"
        ]
      },
      "choices": [
        {
          "value": "0.25",
          "label": "Last 15 minutes"
        },
        {
          "value": "0.5",
          "label": "Last 30 minutes"
        },
        {
          "value": "1",
          "label": "Last hour"
        },
        {
          "value": "3",
          "label": "Last 3 hours"
        },
        {
          "value": "6",
          "label": "Last 6 hours"
        },
        {
          "value": "12",
          "label": "Last 12 hours"
        },
        {
          "value": "today",
          "label": "Today"
        },
        {
          "value": "72",
          "label": "Last 3 days"
        },
        {
          "value": "week",
          "label": "Last week"
        },
        {
          "value": "720",
          "label": "Last 30 days"
        },
        {
          "value": "0",
          "label": "All time"
        }
      ]
    },
    {
      "name": "count",
      "type": "select",
      "label": "How many",
      "default": "6",
      "choices": [
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "8",
          "label": "8"
        },
        {
          "value": "10",
          "label": "10"
        },
        {
          "value": "12",
          "label": "12"
        }
      ],
      "show_if": {
        "layout": [
          "list",
          "latest",
          "gallery",
          "chart",
          "plate"
        ]
      }
    },
    {
      "name": "pick",
      "type": "select",
      "label": "Which birds, when there are more",
      "default": "order",
      "show_if": {
        "layout": [
          "list",
          "latest",
          "gallery",
          "chart",
          "plate"
        ]
      },
      "help": "The birds the page keeps when more were heard than it shows. As ordered keeps the first ones in the order (More options); the others are Fugleramme's rankings, and the birds kept are still shown in the order.",
      "choices": [
        {
          "value": "order",
          "label": "As ordered"
        },
        {
          "value": "heard",
          "label": "The most heard"
        },
        {
          "value": "rarest",
          "label": "The rarest in the window"
        },
        {
          "value": "rarest_ever",
          "label": "The rarest all time"
        },
        {
          "value": "last_heard",
          "label": "The latest heard"
        }
      ]
    },
    {
      "name": "caption",
      "type": "select",
      "label": "Caption",
      "default": "band",
      "show_if": {
        "layout": "bleed"
      },
      "help": "Only used by the full bleed layout. Folio, museum, figure and cyanotype are natural-history styles; stamp, woodblock, cameo and Art Nouveau frame the bird as a postage stamp, a Japanese print with a seal, an oval on a dark mat, and an arched poster. The serif and handwritten styles have fine strokes that suit colour and greyscale panels better than black and white ones.",
      "choices": [
        {
          "value": "band",
          "label": "Name band"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "notebook",
          "label": "Field notebook"
        },
        {
          "value": "tag",
          "label": "Specimen tag"
        },
        {
          "value": "poster",
          "label": "Poster"
        },
        {
          "value": "folio",
          "label": "Folio plate"
        },
        {
          "value": "museum",
          "label": "Museum label"
        },
        {
          "value": "figure",
          "label": "Scientific figure"
        },
        {
          "value": "cyanotype",
          "label": "Cyanotype"
        },
        {
          "value": "stamp",
          "label": "Postage stamp"
        },
        {
          "value": "woodblock",
          "label": "Woodblock print"
        },
        {
          "value": "cameo",
          "label": "Cameo"
        },
        {
          "value": "nouveau",
          "label": "Art Nouveau"
        },
        {
          "value": "sonogram",
          "label": "Sonogram: the bird's latest call as a scientific strip"
        }
      ]
    },
    {
      "name": "hero",
      "type": "select",
      "label": "Which bird",
      "default": "latest",
      "help": "The bird the field log, latest visitor, book plate and full bleed layouts show, from the window's birds. The newest arrival is a bird BirdNET-Go flags as new, one back after a long absence, or over a longer window the bird the widget's log of the garden met latest; the rarest uses that log of the days each bird was heard here.",
      "choices": [
        {
          "value": "latest",
          "label": "The latest heard"
        },
        {
          "value": "new",
          "label": "The newest arrival"
        },
        {
          "value": "busy",
          "label": "The most heard"
        },
        {
          "value": "rare",
          "label": "The rarest"
        },
        {
          "value": "quiet",
          "label": "The least heard"
        }
      ],
      "show_if": {
        "layout": [
          "list",
          "latest",
          "plate",
          "bleed"
        ]
      }
    },
    {
      "name": "song_line",
      "type": "boolean",
      "label": "Song line",
      "default": true,
      "help": "A small line under the bird's name tracing its latest call, from BirdNET-Go's sonogram of the detection (a made-up one in the demo garden).",
      "show_if": {
        "layout": [
          "list",
          "latest",
          "plate",
          "bleed"
        ]
      }
    },
    {
      "name": "cluster_style",
      "type": "select",
      "label": "Style",
      "default": "sheet",
      "show_if": {
        "layout": "cluster",
        "cluster_arrange": {
          "not": "fal"
        }
      },
      "help": "How the printed page looks: a specimen sheet named underneath, a numbered plate with a key, a wreath round a title, a field notebook with taped-in birds, or a specimen drawer with museum tags. With classic plates the birds are cut from the plates, no fal.ai needed; with an AI option from each bird's own painting. Not used when the arrangement is fal.ai.",
      "choices": [
        {
          "value": "sheet",
          "label": "Specimen sheet"
        },
        {
          "value": "numbered",
          "label": "Numbered plate with a key"
        },
        {
          "value": "wreath",
          "label": "Wreath round a title"
        },
        {
          "value": "notebook",
          "label": "Field notebook"
        },
        {
          "value": "drawer",
          "label": "Specimen drawer"
        }
      ]
    },
    {
      "name": "cluster_size",
      "type": "select",
      "label": "How many",
      "default": "8",
      "show_if": {
        "layout": "cluster"
      },
      "help": "How many of the window's birds the cluster shows. A blended scene takes at most 6.",
      "choices": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "8",
          "label": "8"
        },
        {
          "value": "10",
          "label": "10"
        },
        {
          "value": "12",
          "label": "12"
        },
        {
          "value": "16",
          "label": "16"
        },
        {
          "value": "20",
          "label": "20"
        },
        {
          "value": "24",
          "label": "24"
        }
      ]
    },
    {
      "name": "ranking",
      "type": "select",
      "label": "Which birds, when there are more",
      "default": "heard",
      "show_if": {
        "layout": "cluster"
      },
      "help": "After Fugleramme: the birds heard most in the window, the ones heard least, the ones the widget's own log of the garden has met on the fewest days, or the latest heard.",
      "choices": [
        {
          "value": "heard",
          "label": "The most heard"
        },
        {
          "value": "rarest",
          "label": "The rarest in the window"
        },
        {
          "value": "rarest_ever",
          "label": "The rarest all time"
        },
        {
          "value": "last_heard",
          "label": "The latest heard"
        }
      ]
    },
    {
      "name": "cluster_arrange",
      "type": "select",
      "label": "Arrangement",
      "default": "auto",
      "help": "Where the birds go on the page. Each look has its own (an oval for the sheet and numbered plate, a ring for the wreath, rows for the notebook); the drawer always uses its compartments. Spiral and Voids pack the birds by their outlines with Fugleramme's packer, each name tucked under its bird: Spiral grows out from the middle with the biggest birds there, Voids puts each bird on the emptiest paper and fills the page. fal.ai composes the scene repaints up to six birds together as one picture, about US$0.04 a time, and takes the scene options below.",
      "choices": [
        {
          "value": "auto",
          "label": "The look's own"
        },
        {
          "value": "oval",
          "label": "Oval, biggest in the middle"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "ring",
          "label": "Ring round an empty middle"
        },
        {
          "value": "rows",
          "label": "Rows, top left first"
        },
        {
          "value": "scatter",
          "label": "Scattered"
        },
        {
          "value": "heap",
          "label": "Heap, biggest at the bottom"
        },
        {
          "value": "spiral",
          "label": "Spiral (Fugleramme)"
        },
        {
          "value": "voids",
          "label": "Voids (Fugleramme)"
        },
        {
          "value": "fal",
          "label": "fal.ai composes the scene (one more AI pass)"
        }
      ],
      "show_if": {
        "layout": "cluster"
      }
    },
    {
      "name": "spotlight",
      "type": "boolean",
      "label": "Spotlight the latest bird",
      "default": false,
      "show_if": {
        "layout": "cluster",
        "pictures": [
          "plate_photo",
          "plate_gen",
          "gen"
        ],
        "cluster_arrange": {
          "not": "fal"
        },
        "cluster_style": [
          "sheet",
          "numbered",
          "notebook"
        ]
      },
      "help": "After Fugleramme: the bird heard last is drawn large in the middle, its name larger, with the rest packed round it. For the specimen sheet, the numbered plate and the field notebook."
    },
    {
      "name": "cluster_text",
      "type": "select",
      "label": "Text",
      "default": "key",
      "show_if": {
        "layout": "cluster"
